{
  "name": "obsidian-wikipedia-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin that keeps Wikipedia citation links intact when you paste from Wikipedia.",
  "license": "MIT",
  "author": "Corey Struzan",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:scratch": "tsx scratch/test_citation_paste.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
